<?xml version="1.0" encoding="utf-8"?>
<!-- Verifies and generates through an Exec of quod, not a task loaded in MSBuild: the same file works
     under the MSBuild of Visual Studio and under dotnet build, with SDK and old-style projects. -->
<Project>
  <PropertyGroup>
    <QuodToolsRoot>$(MSBuildThisFileDirectory)..\tools\</QuodToolsRoot>
    <QuodRid Condition="'$(OS)' == 'Windows_NT'">win-x64</QuodRid>
    <QuodArchitecture Condition="'$(OS)' != 'Windows_NT'">$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</QuodArchitecture>
    <QuodRid Condition="'$(QuodRid)' == '' And $([MSBuild]::IsOSPlatform('OSX')) And '$(QuodArchitecture)' == 'Arm64'">osx-arm64</QuodRid>
    <QuodRid Condition="'$(QuodRid)' == '' And $([MSBuild]::IsOSPlatform('Linux')) And '$(QuodArchitecture)' == 'X64'">linux-x64</QuodRid>
    <QuodExeName Condition="'$(OS)' == 'Windows_NT'">quod.exe</QuodExeName>
    <QuodExeName Condition="'$(QuodExeName)' == ''">quod</QuodExeName>
    <QuodExe Condition="'$(QuodExe)' == ''">$(QuodToolsRoot)$(QuodRid)\$(QuodExeName)</QuodExe>
    <QuodNamespace Condition="'$(QuodNamespace)' == ''">$(RootNamespace)</QuodNamespace>
    <QuodNamespace Condition="'$(QuodNamespace)' == ''">Quod.Generated</QuodNamespace>
    <QuodBudget Condition="'$(QuodBudget)' == ''">300</QuodBudget>
    <QuodOutputDir>$(IntermediateOutputPath)quod\</QuodOutputDir>
    <QuodArguments>--target csharp --format msbuild --namespace "$(QuodNamespace)" --budget $(QuodBudget)</QuodArguments>
    <QuodArguments Condition="'$(QuodRequireContracts)' == 'true'">$(QuodArguments) --require-contracts</QuodArguments>
    <QuodArguments Condition="'$(QuodCheckAllRequires)' == 'true'">$(QuodArguments) --check-requires all</QuodArguments>
    <QuodArguments>$(QuodArguments) $(QuodBuildOptions)</QuodArguments>
    <QuodArgumentsFile>$(QuodOutputDir)quod.args</QuodArgumentsFile>
  </PropertyGroup>

  <!-- .NET Framework projects do not reference BigInteger's assembly by default. -->
  <Target Name="QuodFrameworkReferences" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework' And '@(QuodCompile)' != ''">
    <ItemGroup>
      <Reference Include="System.Numerics" Exclude="@(Reference)" />
    </ItemGroup>
  </Target>

  <!-- Changing an option must verify again, so the options are an input: a file rewritten only when they change. -->
  <Target Name="QuodWriteArguments">
    <Error Condition="'$(QuodRid)' == '' And '@(QuodCompile)' != ''"
           Text="Quod.Build has no quod for this system ($(QuodArchitecture)): it runs on Windows x64, Linux x64 and macOS on Apple silicon. Set QuodExe to a quod of your own." />
    <MakeDir Directories="$(QuodOutputDir)" />
    <WriteLinesToFile File="$(QuodArgumentsFile)" Lines="$(QuodArguments.Replace(';', '%3B'))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(QuodArgumentsFile)" />
    </ItemGroup>
  </Target>

  <!-- A file proves against what it imports, which need not be listed: every .quod next to a listed one is an input.
       Inputs and outputs do not pair up here, so a change to any of them verifies everything again. -->
  <Target Name="QuodFindModules">
    <ItemGroup>
      <QuodModule Include="%(QuodCompile.RootDir)%(QuodCompile.Directory)*.quod" />
    </ItemGroup>
  </Target>

  <Target Name="QuodGenerate" DependsOnTargets="QuodWriteArguments;QuodFindModules"
          Inputs="@(QuodCompile);@(QuodModule);$(QuodExe);$(QuodArgumentsFile)"
          Outputs="@(QuodCompile->'$(QuodOutputDir)%(RecursiveDir)%(Filename).g.cs')">
    <!-- a module no longer imported must not stay in the compilation -->
    <ItemGroup>
      <QuodStale Include="$(QuodOutputDir)**\*.g.cs" />
    </ItemGroup>
    <Delete Files="@(QuodStale)" />
    <!-- a NuGet package does not keep the execute permission -->
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="chmod +x &quot;$(QuodExe)&quot; &quot;$(QuodToolsRoot)$(QuodRid)/z3&quot;" />
    <!-- quod reports its diagnostics in MSBuild's format. They do not fail the build by themselves under every MSBuild (an
         old-style project under Visual Studio's went on to compile the previous file), so the exit code does, without MSB3073. -->
    <Exec Command="&quot;$(QuodExe)&quot; build &quot;%(QuodCompile.FullPath)&quot; $(QuodArguments) --output-file &quot;$(QuodOutputDir)%(QuodCompile.RecursiveDir)%(QuodCompile.Filename).g.cs&quot;"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" ItemName="QuodExitCode" />
    </Exec>
    <Error Condition="'%(QuodExitCode.Identity)' == '1'" Text="Quod verification failed: see the errors above." />
    <Error Condition="'%(QuodExitCode.Identity)' != '0' And '%(QuodExitCode.Identity)' != '1'" Text="quod did not run (exit code %(QuodExitCode.Identity)): $(QuodExe)" />
  </Target>

  <Target Name="QuodAddGenerated" BeforeTargets="CoreCompile" DependsOnTargets="QuodGenerate" Condition="'@(QuodCompile)' != ''">
    <ItemGroup>
      <!-- the listed files, and the modules they import -->
      <QuodGenerated Include="$(QuodOutputDir)**\*.g.cs" />
      <Compile Include="@(QuodGenerated)" />
      <FileWrites Include="@(QuodGenerated)" />
    </ItemGroup>
  </Target>
</Project>
