// Expansion of a single run: value v repeated c times (empty when c <= 0).
fn rep(v: int, c: int) -> seq<int>
  decreases c
{
  if c <= 0 { [] } else { [v] + rep(v, c - 1) }
}

// Expansion of a run-length encoded sequence.
fn expand(p: seq<(int, int)>) -> seq<int>
  decreases len(p)
{
  if len(p) == 0 { [] } else { rep(p[0].0, p[0].1) + expand(p[1..]) }
}

// Every run has a count >= 1.
fn all_counts_pos(p: seq<(int, int)>) -> bool
  decreases len(p)
{
  if len(p) == 0 { true } else { p[0].1 >= 1 && all_counts_pos(p[1..]) }
}

// Adjacent runs have different values (runs are maximal).
fn adjacent_distinct(p: seq<(int, int)>) -> bool
  decreases len(p)
{
  if len(p) <= 1 { true } else { p[0].0 != p[1].0 && adjacent_distinct(p[1..]) }
}

lemma rep_snoc(v: int, c: int)
  requires c >= 0
  ensures rep(v, c + 1) == rep(v, c) + [v]
  decreases c
{
  if c > 0 {
    rep_snoc(v, c - 1);
  }
}

lemma expand_snoc(p: seq<(int, int)>, v: int, c: int)
  ensures expand(p + [(v, c)]) == expand(p) + rep(v, c)
  decreases len(p)
{
  if len(p) > 0 {
    assert (p + [(v, c)])[1..] == p[1..] + [(v, c)];
    expand_snoc(p[1..], v, c);
  }
}

lemma counts_snoc(p: seq<(int, int)>, v: int, c: int)
  requires all_counts_pos(p)
  requires c >= 1
  ensures all_counts_pos(p + [(v, c)])
  decreases len(p)
{
  if len(p) > 0 {
    assert (p + [(v, c)])[1..] == p[1..] + [(v, c)];
    counts_snoc(p[1..], v, c);
  }
}

lemma adjacent_snoc(p: seq<(int, int)>, v: int, c: int)
  requires adjacent_distinct(p)
  requires len(p) > 0 ==> p[len(p) - 1].0 != v
  ensures adjacent_distinct(p + [(v, c)])
  decreases len(p)
{
  if len(p) > 1 {
    assert (p + [(v, c)])[1..] == p[1..] + [(v, c)];
    adjacent_snoc(p[1..], v, c);
  }
}

// Run-length encoding: maximal runs of equal consecutive values, in order.
fn rle_encode(xs: seq<int>) -> seq<(int, int)>
  ensures all_counts_pos(result)
  ensures adjacent_distinct(result)
  ensures expand(result) == xs
{
  let mut out: seq<(int, int)> = [];
  let mut cur_v: int = 0;
  let mut cur_c: int = 0;
  let mut i: int = 0;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    invariant cur_c >= 0
    invariant cur_c == 0 ==> len(out) == 0
    invariant expand(out) + rep(cur_v, cur_c) == xs[..i]
    invariant all_counts_pos(out)
    invariant adjacent_distinct(out)
    invariant len(out) > 0 && cur_c > 0 ==> out[len(out) - 1].0 != cur_v
    decreases len(xs) - i
  {
    assert xs[..i + 1] == xs[..i] + [xs[i]];
    if cur_c > 0 && cur_v == xs[i] {
      rep_snoc(cur_v, cur_c);
      cur_c = cur_c + 1;
    } else {
      if cur_c > 0 {
        expand_snoc(out, cur_v, cur_c);
        counts_snoc(out, cur_v, cur_c);
        adjacent_snoc(out, cur_v, cur_c);
        out = out + [(cur_v, cur_c)];
      }
      cur_v = xs[i];
      cur_c = 1;
    }
    i = i + 1;
  }
  assert xs[..len(xs)] == xs;
  if cur_c > 0 {
    expand_snoc(out, cur_v, cur_c);
    counts_snoc(out, cur_v, cur_c);
    adjacent_snoc(out, cur_v, cur_c);
    return out + [(cur_v, cur_c)];
  }
  return out;
}
