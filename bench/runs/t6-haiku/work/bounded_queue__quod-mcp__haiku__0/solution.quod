// One queue operation applied to the queue content q.
// x > 0 pushes x (dropping the oldest element first when full);
// x == 0 pops the oldest element (the pop's output is handled separately).
fn step_q(capacity: int, q: seq<int>, x: int) -> seq<int>
  requires capacity >= 1
  requires x >= 0
{
  if x > 0 {
    if len(q) == capacity { q[1..] + [x] } else { q + [x] }
  } else {
    if len(q) == 0 { q } else { q[1..] }
  }
}

// Queue content after the first n operations.
fn qstate(capacity: int, ops: seq<int>, n: int) -> seq<int>
  requires capacity >= 1
  requires forall i in 0..len(ops): ops[i] >= 0
  requires 0 <= n && n <= len(ops)
  decreases n
{
  if n == 0 { [] } else { step_q(capacity, qstate(capacity, ops, n - 1), ops[n - 1]) }
}

// Outputs produced by the first n operations.
fn outs(capacity: int, ops: seq<int>, n: int) -> seq<int>
  requires capacity >= 1
  requires forall i in 0..len(ops): ops[i] >= 0
  requires 0 <= n && n <= len(ops)
  decreases n
{
  if n == 0 { [] } else {
    outs(capacity, ops, n - 1) + (if ops[n - 1] == 0 {
      if len(qstate(capacity, ops, n - 1)) == 0 { [-1] } else { [qstate(capacity, ops, n - 1)[0]] }
    } else { [] })
  }
}

lemma qstate_succ(capacity: int, ops: seq<int>, n: int)
  requires capacity >= 1
  requires forall i in 0..len(ops): ops[i] >= 0
  requires 0 <= n && n < len(ops)
  ensures qstate(capacity, ops, n + 1) == step_q(capacity, qstate(capacity, ops, n), ops[n])
{
}

lemma outs_succ(capacity: int, ops: seq<int>, n: int)
  requires capacity >= 1
  requires forall i in 0..len(ops): ops[i] >= 0
  requires 0 <= n && n < len(ops)
  ensures outs(capacity, ops, n + 1) == outs(capacity, ops, n) + (if ops[n] == 0 {
      if len(qstate(capacity, ops, n)) == 0 { [-1] } else { [qstate(capacity, ops, n)[0]] }
    } else { [] })
{
}

fn bounded_queue(capacity: int, ops: seq<int>) -> seq<int>
  requires capacity >= 1
  requires forall i in 0..len(ops): ops[i] >= 0
  ensures result == outs(capacity, ops, len(ops))
{
  let mut q: seq<int> = [];
  let mut out: seq<int> = [];
  let mut i = 0;
  while i < len(ops)
    invariant 0 <= i && i <= len(ops)
    invariant q == qstate(capacity, ops, i)
    invariant out == outs(capacity, ops, i)
    decreases len(ops) - i
  {
    qstate_succ(capacity, ops, i);
    outs_succ(capacity, ops, i);
    let x = ops[i];
    if x > 0 {
      if len(q) == capacity {
        q = q[1..];
      }
      q = q + [x];
    } else {
      if len(q) == 0 {
        out = out + [-1];
      } else {
        out = out + [q[0]];
        q = q[1..];
      }
    }
    i = i + 1;
  }
  return out;
}
