// One operation at index i (0 <= i < len(ops)), on queue contents q (oldest first):
// the new queue contents.
// An op 0 pops the oldest element (if any); an op x > 0 pushes x, after dropping
// the oldest element when the queue is full.
fn next_q(cap: int, ops: seq<int>, i: int, q: seq<int>) -> seq<int>
  requires cap >= 1
  requires 0 <= i < len(ops)
{
  if ops[i] == 0 {
    if len(q) == 0 { q } else { q[1..] }
  }
  else if len(q) == cap { q[1..] + [ops[i]] }
  else { q + [ops[i]] }
}

// The same operation: the output extended by what the operation emits.
fn next_out(cap: int, ops: seq<int>, i: int, q: seq<int>, out: seq<int>) -> seq<int>
  requires cap >= 1
  requires 0 <= i < len(ops)
{
  if ops[i] == 0 {
    if len(q) == 0 { out + [-1] } else { out + [q[0]] }
  }
  else { out }
}

// Model: the output of the simulation, from operation index i, with queue
// contents q and output so far out. Each step is one operation.
fn run(cap: int, ops: seq<int>, i: int, q: seq<int>, out: seq<int>) -> seq<int>
  requires cap >= 1
  requires 0 <= i <= len(ops)
  decreases len(ops) - i
{
  if i == len(ops) { out }
  else { run(cap, ops, i + 1, next_q(cap, ops, i, q), next_out(cap, ops, i, q, out)) }
}

fn bounded_queue(capacity: int, ops: seq<int>) -> seq<int>
  requires capacity >= 1
  requires forall j in 0..len(ops): ops[j] >= 0
  ensures result == run(capacity, ops, 0, [], [])
{
  let mut q: seq<int> = [];
  let mut out: seq<int> = [];
  let mut i: int = 0;
  while i < len(ops)
    invariant 0 <= i <= len(ops)
    invariant run(capacity, ops, i, q, out) == run(capacity, ops, 0, [], [])
    decreases len(ops) - i
  {
    out = next_out(capacity, ops, i, q, out);
    q = next_q(capacity, ops, i, q);
    i = i + 1;
  }
  return out;
}
