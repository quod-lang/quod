// Run-length encoding of a list of integers.
//
// `repeat(v, c)` is the sequence of `c` copies of `v` (empty when c <= 0).
// `expand(p)` concatenates the runs of `p`: it is the sequence that the
// run-length encoding `p` stands for.

fn repeat(v: int, c: int) -> seq<int>
  decreases c
{
  if c <= 0 { [] } else { [v] + repeat(v, c - 1) }
}

fn expand(p: seq<(int, int)>) -> seq<int>
  decreases len(p)
{
  if len(p) == 0 { [] } else { repeat(p[0].0, p[0].1) + expand(p[1..]) }
}

// One more copy of v extends the run by one element.
lemma repeat_snoc(v: int, c: int)
  requires c >= 0
  ensures repeat(v, c + 1) == repeat(v, c) + [v]
  decreases c
{
  if c > 0 {
    repeat_snoc(v, c - 1);
  }
}

// Appending an element leaves the earlier indices unchanged and puts it last.
lemma snoc_index(p: seq<(int, int)>, x: (int, int))
  ensures forall k in 0..len(p): (p + [x])[k] == p[k]
  ensures (p + [x])[len(p)] == x
{
}

// Appending a run with a positive count keeps every count positive.
lemma snoc_counts(p: seq<(int, int)>, x: (int, int))
  requires forall k in 0..len(p): p[k].1 >= 1
  requires x.1 >= 1
  ensures forall k in 0..len(p + [x]): (p + [x])[k].1 >= 1
{
  snoc_index(p, x);
}

// Appending a run whose value differs from the last one keeps adjacent values distinct.
lemma snoc_adj(p: seq<(int, int)>, x: (int, int))
  requires forall k in 0..len(p) - 1: p[k].0 != p[k + 1].0
  requires len(p) > 0 ==> p[len(p) - 1].0 != x.0
  ensures forall k in 0..len(p + [x]) - 1: (p + [x])[k].0 != (p + [x])[k + 1].0
{
  snoc_index(p, x);
}

// Appending a run appends its expansion.
lemma expand_snoc(p: seq<(int, int)>, x: (int, int))
  ensures expand(p + [x]) == expand(p) + repeat(x.0, x.1)
  decreases len(p)
{
  if len(p) > 0 {
    assert (p + [x])[0] == p[0];
    assert (p + [x])[1..] == p[1..] + [x];
    expand_snoc(p[1..], x);
  }
}

fn rle_encode(xs: seq<int>) -> seq<(int, int)>
  ensures expand(result) == xs
  ensures forall k in 0..len(result): result[k].1 >= 1
  ensures forall k in 0..len(result) - 1: result[k].0 != result[k + 1].0
{
  // r: the closed runs; (cv, cc): the current run, still open (cc = 0 before the first element).
  let mut r: seq<(int, int)> = [];
  let mut cv = 0;
  let mut cc = 0;
  let mut i = 0;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    invariant cc >= 0
    invariant expand(r) + repeat(cv, cc) == xs[..i]
    invariant forall k in 0..len(r): r[k].1 >= 1
    invariant forall k in 0..len(r) - 1: r[k].0 != r[k + 1].0
    invariant cc == 0 ==> len(r) == 0
    invariant cc > 0 && len(r) > 0 ==> r[len(r) - 1].0 != cv
    decreases len(xs) - i
  {
    assert xs[..i + 1] == xs[..i] + [xs[i]];
    if cc > 0 && cv == xs[i] {
      repeat_snoc(cv, cc);
      cc = cc + 1;
    } else {
      if cc > 0 {
        expand_snoc(r, (cv, cc));
        snoc_counts(r, (cv, cc));
        snoc_adj(r, (cv, cc));
        r = r + [(cv, cc)];
      }
      cv = xs[i];
      cc = 1;
    }
    i = i + 1;
  }
  if cc > 0 {
    expand_snoc(r, (cv, cc));
    snoc_counts(r, (cv, cc));
    snoc_adj(r, (cv, cc));
    r = r + [(cv, cc)];
  }
  return r;
}
