// Rotate a sequence to the right by k positions (k may be any integer).
// Element i of the result is xs[(i - k) mod n]; for n = 0 the result is empty.
fn rotate(xs: seq<int>, k: int) -> seq<int>
  ensures len(result) == len(xs)
  ensures forall i in 0..len(xs): result[i] == xs[(i - k) % len(xs)]
{
  let n: int = len(xs);
  let mut out: seq<int> = [];
  let mut i: int = 0;
  while i < n
    invariant 0 <= i <= n
    invariant len(out) == i
    invariant forall j in 0..i: out[j] == xs[(j - k) % n]
    decreases n - i
  {
    out = out + [xs[(i - k) % n]];
    i = i + 1;
  }
  return out;
}
