// Queue state after applying the first n operations (model of the queue).
// Push x > 0: if full, drop the oldest element, then append x.
// Pop 0: remove the oldest element if any.
fn qstep(q: seq<int>, capacity: int, x: int) -> seq<int>
  requires capacity >= 1
{
  if x > 0 {
    if len(q) >= capacity { q[1..] + [x] } else { q + [x] }
  } else {
    if len(q) == 0 { q } else { q[1..] }
  }
}

fn qstate(capacity: int, ops: seq<int>, n: int) -> seq<int>
  requires capacity >= 1
  requires 0 <= n && n <= len(ops)
  decreases n
{
  if n == 0 { [] } else { qstep(qstate(capacity, ops, n - 1), capacity, ops[n - 1]) }
}

// Output produced by the first n operations.
fn qout(capacity: int, ops: seq<int>, n: int) -> seq<int>
  requires capacity >= 1
  requires 0 <= n && n <= len(ops)
  decreases n
{
  if n == 0 {
    []
  } else if ops[n - 1] > 0 {
    qout(capacity, ops, n - 1)
  } else if len(qstate(capacity, ops, n - 1)) == 0 {
    qout(capacity, ops, n - 1) + [-1]
  } else {
    qout(capacity, ops, n - 1) + [qstate(capacity, ops, n - 1)[0]]
  }
}

fn bounded_queue(capacity: int, ops: seq<int>) -> seq<int>
  requires capacity >= 1
  requires forall i in 0..len(ops): ops[i] >= 0
  ensures result == qout(capacity, ops, len(ops))
{
  let mut q: seq<int> = [];
  let mut out: seq<int> = [];
  let mut i = 0;
  while i < len(ops)
    invariant 0 <= i && i <= len(ops)
    invariant q == qstate(capacity, ops, i)
    invariant out == qout(capacity, ops, i)
    decreases len(ops) - i
  {
    let x = ops[i];
    if x > 0 {
      if len(q) >= capacity {
        q = q[1..] + [x];
      } else {
        q = q + [x];
      }
    } else {
      if len(q) == 0 {
        out = out + [-1];
      } else {
        out = out + [q[0]];
        q = q[1..];
      }
    }
    i = i + 1;
  }
  return out;
}
