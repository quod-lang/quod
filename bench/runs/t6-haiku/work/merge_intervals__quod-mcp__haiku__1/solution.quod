// Reference model: insert one interval into a canonical list (sorted by start,
// pairwise disjoint, touching intervals merged). Closed intervals overlap when
// each starts before the other ends.
fn ins_model(x: (int, int), acc: seq<(int, int)>) -> seq<(int, int)>
  decreases len(acc)
{
  if len(acc) == 0 {
    [x]
  } else if acc[0].1 < x.0 {
    [acc[0]] + ins_model(x, acc[1..])
  } else if x.1 < acc[0].0 {
    [x] + acc
  } else {
    ins_model((if x.0 <= acc[0].0 { x.0 } else { acc[0].0 }, if x.1 >= acc[0].1 { x.1 } else { acc[0].1 }), acc[1..])
  }
}

// Reference model: insert the first n intervals of iv, in order.
fn fold_model(iv: seq<(int, int)>, n: nat) -> seq<(int, int)>
  requires n <= len(iv)
  decreases n
{
  if n == 0 {
    []
  } else {
    ins_model(iv[n - 1], fold_model(iv, n - 1))
  }
}

// Inserts one interval into a canonical list, by a left-to-right sweep.
fn insert_iv(x: (int, int), acc: seq<(int, int)>) -> seq<(int, int)>
  ensures result == ins_model(x, acc)
{
  let mut out: seq<(int, int)> = [];
  let mut cur: (int, int) = x;
  let mut k: nat = 0;
  while k < len(acc) && (acc[k].1 < cur.0 || !(cur.1 < acc[k].0))
    invariant 0 <= k && k <= len(acc)
    invariant out + ins_model(cur, acc[k..]) == ins_model(x, acc)
    decreases len(acc) - k
  {
    assert acc[k..][0] == acc[k];
    assert acc[k..][1..] == acc[k + 1..];
    if acc[k].1 < cur.0 {
      assert ins_model(cur, acc[k..]) == [acc[k]] + ins_model(cur, acc[k + 1..]);
      out = out + [acc[k]];
    } else {
      let nlo = if cur.0 <= acc[k].0 { cur.0 } else { acc[k].0 };
      let nhi = if cur.1 >= acc[k].1 { cur.1 } else { acc[k].1 };
      assert acc[k].1 >= cur.0;
      assert !(cur.1 < acc[k].0);
      assert ins_model(cur, acc[k..]) == ins_model((nlo, nhi), acc[k + 1..]);
      cur = (nlo, nhi);
    }
    k = k + 1;
  }
  return out + ins_model(cur, acc[k..]);
}

fn merge_intervals(iv: seq<(int, int)>) -> seq<(int, int)>
  requires forall j in 0..len(iv): iv[j].0 <= iv[j].1
  ensures result == fold_model(iv, len(iv))
{
  let mut acc: seq<(int, int)> = [];
  let mut i: nat = 0;
  while i < len(iv)
    invariant 0 <= i && i <= len(iv)
    invariant acc == fold_model(iv, i)
    decreases len(iv) - i
  {
    acc = insert_iv(iv[i], acc);
    i = i + 1;
  }
  return acc;
}
