// Binary search on a sorted sequence (duplicates allowed).
// Returns the index of the first occurrence of target, or -1 if absent.
// The result is fully determined (leftmost occurrence), so no `loose` is needed.
fn binary_search(xs: seq<int>, target: int) -> int
  requires forall i in 0..len(xs): forall j in i..len(xs): xs[i] <= xs[j]
  ensures result == -1 ==> forall i in 0..len(xs): xs[i] != target
  ensures result != -1 ==> 0 <= result && result < len(xs) && xs[result] == target
  ensures result != -1 ==> forall i in 0..result: xs[i] != target
{
  // Invariant: every element before lo is < target, every element from hi on is >= target.
  // Loop ends with lo == hi, the first index whose element is >= target.
  let mut lo: int = 0;
  let mut hi: int = len(xs);
  while lo < hi
    invariant 0 <= lo && lo <= hi && hi <= len(xs)
    invariant forall i in 0..lo: xs[i] < target
    invariant forall i in hi..len(xs): xs[i] >= target
    decreases hi - lo
  {
    let mid: int = lo + (hi - lo) / 2;
    if xs[mid] < target {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  if lo < len(xs) && xs[lo] == target { lo } else { -1 }
}
