// Model of the bounded queue: the contents after the first n operations,
// and the output produced by those n operations.

// Queue contents after one operation x applied to q.
// A push (x > 0) drops the oldest element first if the queue is full.
// A pop (x == 0) removes the oldest element if there is one.
fn queue_step(capacity: int, q: seq<int>, x: int) -> seq<int>
  requires capacity >= 1
{
  if x > 0 {
    if len(q) == capacity { q[1..] + [x] } else { q + [x] }
  } else {
    if len(q) == 0 { q } else { q[1..] }
  }
}

// Output produced by one operation x applied to queue q.
fn out_step(q: seq<int>, x: int) -> seq<int>
{
  if x > 0 {
    []
  } else {
    if len(q) == 0 { [-1] } else { [q[0]] }
  }
}

// Queue contents after the first n operations.
fn queue_after(capacity: int, ops: seq<int>, n: int) -> seq<int>
  requires capacity >= 1
  requires 0 <= n <= len(ops)
  decreases n
{
  if n == 0 {
    []
  } else {
    queue_step(capacity, queue_after(capacity, ops, n - 1), ops[n - 1])
  }
}

// Output produced by the first n operations.
fn outputs_after(capacity: int, ops: seq<int>, n: int) -> seq<int>
  requires capacity >= 1
  requires 0 <= n <= len(ops)
  decreases n
{
  if n == 0 {
    []
  } else {
    outputs_after(capacity, ops, n - 1) + out_step(queue_after(capacity, ops, n - 1), ops[n - 1])
  }
}

fn bounded_queue(capacity: int, ops: seq<int>) -> seq<int>
  requires capacity >= 1
  requires forall i in 0..len(ops): ops[i] >= 0
  ensures result == outputs_after(capacity, ops, len(ops))
{
  let mut q: seq<int> = [];
  let mut out: seq<int> = [];
  let mut i: int = 0;
  while i < len(ops)
    invariant 0 <= i <= len(ops)
    invariant len(q) <= capacity
    invariant q == queue_after(capacity, ops, i)
    invariant out == outputs_after(capacity, ops, i)
    decreases len(ops) - i
  {
    let x = ops[i];
    if x > 0 {
      if len(q) == capacity {
        q = q[1..] + [x];
      } else {
        q = q + [x];
      }
    } else {
      if len(q) == 0 {
        out = out + [-1];
      } else {
        out = out + [q[0]];
        q = q[1..];
      }
    }
    i = i + 1;
  }
  return out;
}
