fn binary_search(xs: seq<int>, target: int) -> int
  requires forall i in 0..len(xs) - 1: xs[i] <= xs[i + 1]
  ensures xs[result] == target || result == -1
  decreases len(xs)
{
  let mut lo = 0;
  let mut hi = len(xs);
  while lo < hi
    invariant lo <= hi
    invariant forall i in lo..hi: xs[i] < target
    invariant forall i in hi..len(xs): xs[i] > target
    invariant lo >= 0 && hi <= len(xs)
    decreases hi - lo
  {
    let mid = lo + (hi - lo) / 2;
    assert lo <= mid && mid < hi;
    if xs[mid] < target { lo = mid + 1; }
    else if xs[mid] > target { hi = mid; }
    else { return mid; }
  }
  return -1;
}