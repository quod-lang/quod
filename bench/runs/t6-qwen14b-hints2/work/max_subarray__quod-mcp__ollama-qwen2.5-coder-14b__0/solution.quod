fn max_subarray(xs: seq<int>) -> int
  requires len(xs) > 0
  ensures result >= 0
  ensures result == max(sum(xs, i, j) for i in 0..len(xs) for j in i..len(xs))
{
  let mut max_sum = xs[0];
  let mut current_sum = xs[0];
  let mut i = 1;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    invariant max_sum == max(sum(xs, j, k) for j in 0..k for k in j..i)
    invariant current_sum == sum(xs, j, i) for j in 0..i
    decreases len(xs) - i
  {
    current_sum = max(xs[i], current_sum + xs[i]);
    max_sum = max(max_sum, current_sum);
    i = i + 1;
  }
  max_sum
}