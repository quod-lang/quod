fn bounded_queue(capacity: int, ops: seq<int>) -> seq<int>
requires capacity >= 1
ensures len(res) == len(ops)
ensures forall i: nat. i < len(res) -> res[i] == if ops[i] == 0 then (if len(queue) > 0 then queue[0] else -1) else ops[i]
{
  let mut queue: seq<int> := [];
  let mut res: seq<int> := [];
  let mut i = 0;
  while i < len(ops) invariant i <= len(ops) decreases len(ops) - i {
    let op = ops[i];
    if op > 0 {
      if len(queue) == capacity {
        queue = queue[1..];
      }
      queue = queue + [op];
    } else {
      if len(queue) > 0 {
        res = res + [queue[0]];
        queue = queue[1..];
      } else {
        res = res + [-1];
      }
    }
    i = i + 1;
  }
  return res;
}