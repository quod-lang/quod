fn max_subarray(xs: seq<int>) -> int
  requires len(xs) > 0
  ensures result >= 0
  ensures result == max(sum(xs, i, j) | 0 <= i <= j <= len(xs))
{
  let mut max_sum = xs[0];
  let mut current_sum = xs[0];
  let mut i = 1;
  while i < len(xs) invariant 0 <= i && i <= len(xs) decreases len(xs) - i {
    current_sum = max(xs[i], current_sum + xs[i]);
    max_sum = max(max_sum, current_sum);
    i = i + 1;
  }
  max_sum
}