enum Customer { Guest, Member(i32), Business(string) }
enum Coupon { NoCoupon, Percent(i32), Fixed(i32), FreeShipping }

fn cust_ok(c: Customer) -> bool {
  match c { Guest => true, Member(y) => y >= 0, Business(_) => true }
}

fn coupon_ok(k: Coupon) -> bool {
  match k { NoCoupon => true, Percent(p) => 0 <= p && p <= 50, Fixed(v) => v >= 0, FreeShipping => true }
}

fn cust_disc(c: Customer, sub: int) -> int {
  match c {
    Guest => 0,
    Member(y) => if y >= 5 { sub * 5 / 100 } else { sub * 2 / 100 },
    Business(_) => if sub >= 100000 { sub * 3 / 100 } else { 0 },
  }
}

fn coupon_disc(k: Coupon, amount: int) -> int {
  match k {
    NoCoupon => 0,
    Percent(p) => amount * p / 100,
    Fixed(v) => if v < amount { v } else { amount },
    FreeShipping => 0,
  }
}

lemma cust_disc_bounds(c: Customer, sub: int)
  requires sub >= 0
  ensures 0 <= cust_disc(c, sub) && cust_disc(c, sub) <= sub
{
}

lemma coupon_disc_bounds(k: Coupon, amount: int)
  requires amount >= 0 && coupon_ok(k)
  ensures 0 <= coupon_disc(k, amount) && coupon_disc(k, amount) <= amount
{
}

fn is_free(k: Coupon) -> bool {
  match k { FreeShipping => true, _ => false }
}

fn free_threshold(c: Customer) -> int {
  match c { Member(_) => 5000, _ => 10000 }
}

fn reverse_charge(c: Customer, country: string) -> bool {
  match c { Business(v) => len(v) > 0 && country != "FR", _ => false }
}
