import catalog
import discounts
import option

struct Order {
  lines: seq<catalog.Line>,
  customer: discounts.Customer,
  coupon: discounts.Coupon,
  country: string,
}

struct Invoice {
  subtotal: i64,
  discount: i64,
  net: i64,
  shipping: i64,
  vat: i64,
  total: i64,
}

fn min2(a: int, b: int) -> int {
  if a < b { a } else { b }
}

// ---- The model: sums over the first n lines, and the rules of the order. ----

// The sum of the nets of the first n lines.
fn net_upto(ls: seq<catalog.Line>, n: nat) -> int
  requires n <= len(ls)
  decreases n
{
  if n == 0 { 0 } else { net_upto(ls, n - 1) + catalog.line_net(ls[n - 1]) }
}

// The sum of the nets of the first n lines of category c.
fn cat_net_upto(ls: seq<catalog.Line>, n: nat, c: catalog.Category) -> int
  requires n <= len(ls)
  decreases n
{
  if n == 0 {
    0
  } else {
    cat_net_upto(ls, n - 1, c) + (if ls[n - 1].category == c { catalog.line_net(ls[n - 1]) } else { 0 })
  }
}

// The total weight of the first n lines.
fn weight_upto(ls: seq<catalog.Line>, n: nat) -> int
  requires n <= len(ls)
  decreases n
{
  if n == 0 { 0 } else { weight_upto(ls, n - 1) + catalog.line_weight(ls[n - 1]) }
}

// Whether the first n lines are all valid.
fn all_ok_upto(ls: seq<catalog.Line>, n: nat) -> bool
  requires n <= len(ls)
  decreases n
{
  if n == 0 { true } else { all_ok_upto(ls, n - 1) && !catalog.bad_line(ls[n - 1]) }
}

lemma all_ok_elem(ls: seq<catalog.Line>, n: nat, k: nat)
  requires n <= len(ls)
  requires k < n
  requires all_ok_upto(ls, n)
  ensures !catalog.bad_line(ls[k])
  decreases n
{
  if k + 1 < n {
    all_ok_elem(ls, n - 1, k);
  }
}

// The first problem with an order, or "" when it has none.
fn problem(o: Order) -> string {
  if len(o.lines) == 0 {
    "empty order"
  } else if len(o.lines) > 1000 {
    "too many lines"
  } else if !all_ok_upto(o.lines, len(o.lines)) {
    "bad line"
  } else if discounts.bad_customer(o.customer) {
    "bad customer"
  } else if discounts.bad_coupon(o.coupon) {
    "bad coupon"
  } else {
    ""
  }
}

fn subtotal_of(o: Order) -> int {
  net_upto(o.lines, len(o.lines))
}

fn customer_disc_of(o: Order) -> int {
  discounts.customer_discount(o.customer, subtotal_of(o))
}

fn coupon_disc_of(o: Order) -> int {
  discounts.coupon_discount(o.coupon, subtotal_of(o) - customer_disc_of(o))
}

fn discount_of(o: Order) -> int {
  min2(customer_disc_of(o) + coupon_disc_of(o), subtotal_of(o) * 30 / 100)
}

fn net_of(o: Order) -> int {
  subtotal_of(o) - discount_of(o)
}

fn shipping_fee(g: int) -> int {
  if g == 0 {
    0
  } else if g <= 1000 {
    490
  } else if g <= 5000 {
    690
  } else {
    990 + 100 * ((g - 5000 + 999) / 1000)
  }
}

fn shipping_of(o: Order) -> int {
  if discounts.is_free_shipping(o.coupon) || net_of(o) >= discounts.free_threshold(o.customer) {
    0
  } else {
    shipping_fee(weight_upto(o.lines, len(o.lines)))
  }
}

fn vat_of(base: int, rate: int) -> int {
  (base * rate + 500) / 1000
}

fn left_after_std(d: int, s: int) -> int {
  d - min2(d, s)
}

fn left_after_food(d: int, s: int, f: int) -> int {
  left_after_std(d, s) - min2(left_after_std(d, s), f)
}

fn left_after_book(d: int, s: int, f: int, b: int) -> int {
  left_after_food(d, s, f) - min2(left_after_food(d, s, f), b)
}

// The VAT of the four bases (the nets less what the discount takes from each,
// Standard first) and of the shipping.
fn vat_sum(d: int, std_net: int, food_net: int, book_net: int, med_net: int, ship: int) -> int {
  vat_of(std_net - min2(d, std_net), 200)
    + vat_of(food_net - min2(left_after_std(d, std_net), food_net), 55)
    + vat_of(book_net - min2(left_after_food(d, std_net, food_net), book_net), 55)
    + vat_of(med_net - min2(left_after_book(d, std_net, food_net, book_net), med_net), 21)
    + vat_of(ship, 200)
}

// The VAT is at most the bases plus the shipping, plus one cent per term.
lemma vat_sum_bound(d: int, s: int, f: int, b: int, m: int, ship: int)
  requires 0 <= d && 0 <= s && 0 <= f && 0 <= b && 0 <= m && 0 <= ship
  ensures 0 <= vat_sum(d, s, f, b, m, ship)
  ensures vat_sum(d, s, f, b, m, ship) <= s + f + b + m + ship + 5
{
  assert 0 <= left_after_std(d, s) && left_after_std(d, s) <= d;
  assert 0 <= left_after_food(d, s, f) && left_after_food(d, s, f) <= left_after_std(d, s);
  assert 0 <= left_after_book(d, s, f, b) && left_after_book(d, s, f, b) <= left_after_food(d, s, f);
}

fn vat_of_order(o: Order) -> int {
  if discounts.reverse_charge(o.customer, o.country) {
    0
  } else {
    vat_sum(
      discount_of(o),
      cat_net_upto(o.lines, len(o.lines), catalog.Standard),
      cat_net_upto(o.lines, len(o.lines), catalog.Food),
      cat_net_upto(o.lines, len(o.lines), catalog.Book),
      cat_net_upto(o.lines, len(o.lines), catalog.Medicine),
      shipping_of(o),
    )
  }
}

fn total_of(o: Order) -> int {
  net_of(o) + shipping_of(o) + vat_of_order(o)
}

// ---- The price. ----

fn price(o: Order) -> option.Result<Invoice, string>
  ensures len(o.lines) == 0 ==> result == option.Err("empty order")
  ensures match result {
    Err(m) => m != "" && m == problem(o),
    Ok(i) => problem(o) == ""
      && i.subtotal == subtotal_of(o)
      && i.discount == discount_of(o)
      && i.net == net_of(o)
      && i.shipping == shipping_of(o)
      && i.vat == vat_of_order(o)
      && i.total == total_of(o)
      && i.total == i.net + i.shipping + i.vat
      && i.net == i.subtotal - i.discount
      && i.discount >= 0
      && i.discount <= i.subtotal * 30 / 100
      && i.total >= 0,
  }
{
  let n = len(o.lines);
  if n == 0 {
    return option.Err("empty order");
  }
  if n > 1000 {
    return option.Err("too many lines");
  }

  // Validate the lines.
  let mut k: nat = 0;
  let mut lines_ok: bool = true;
  while k < n
    invariant k <= n
    invariant n == len(o.lines)
    invariant lines_ok == all_ok_upto(o.lines, k)
    decreases n - k
  {
    if catalog.bad_line(o.lines[k]) {
      lines_ok = false;
    }
    k = k + 1;
  }
  if !lines_ok {
    return option.Err("bad line");
  }
  if discounts.bad_customer(o.customer) {
    return option.Err("bad customer");
  }
  if discounts.bad_coupon(o.coupon) {
    return option.Err("bad coupon");
  }

  // Sum the nets, the nets per category, and the weight.
  let mut sub: int = 0;
  let mut std_net: int = 0;
  let mut food_net: int = 0;
  let mut book_net: int = 0;
  let mut med_net: int = 0;
  let mut weight: int = 0;
  let mut i: nat = 0;
  while i < n
    invariant i <= n
    invariant n == len(o.lines)
    invariant all_ok_upto(o.lines, n)
    invariant sub == net_upto(o.lines, i)
    invariant std_net == cat_net_upto(o.lines, i, catalog.Standard)
    invariant food_net == cat_net_upto(o.lines, i, catalog.Food)
    invariant book_net == cat_net_upto(o.lines, i, catalog.Book)
    invariant med_net == cat_net_upto(o.lines, i, catalog.Medicine)
    invariant weight == weight_upto(o.lines, i)
    invariant sub == std_net + food_net + book_net + med_net
    invariant 0 <= std_net && 0 <= food_net && 0 <= book_net && 0 <= med_net
    invariant 0 <= sub && sub <= i * 1000000000000
    invariant 0 <= weight && weight <= i * 10000000000
    decreases n - i
  {
    let l = o.lines[i];
    all_ok_elem(o.lines, n, i);
    catalog.net_bound(l);
    catalog.weight_bound(l);
    let x = catalog.line_net(l);
    sub = sub + x;
    if l.category == catalog.Standard {
      std_net = std_net + x;
    }
    if l.category == catalog.Food {
      food_net = food_net + x;
    }
    if l.category == catalog.Book {
      book_net = book_net + x;
    }
    if l.category == catalog.Medicine {
      med_net = med_net + x;
    }
    weight = weight + catalog.line_weight(l);
    i = i + 1;
  }

  // The order.
  let s = sub;
  let cd = discounts.customer_discount(o.customer, s);
  let cp = discounts.coupon_discount(o.coupon, s - cd);
  let d = min2(cd + cp, s * 30 / 100);
  let nt = s - d;
  let ship = if discounts.is_free_shipping(o.coupon) || nt >= discounts.free_threshold(o.customer) {
    0
  } else {
    shipping_fee(weight)
  };
  let v = if discounts.reverse_charge(o.customer, o.country) {
    0
  } else {
    vat_sum(d, std_net, food_net, book_net, med_net, ship)
  };
  let total = nt + ship + v;

  // The bounds that let the amounts go into i64.
  vat_sum_bound(d, std_net, food_net, book_net, med_net, ship);
  assert 0 <= s && s <= 1000000000000000;
  assert 0 <= d && d <= s * 30 / 100;
  assert 0 <= nt && nt <= s;
  assert 0 <= weight && weight <= 10000000000000;
  assert 0 <= ship && ship <= 2000000000000;
  assert 0 <= v && v <= 2000000000000000;
  assert 0 <= total && total <= 4000000000000000;

  option.Ok(Invoice(to_i64(s), to_i64(d), to_i64(nt), to_i64(ship), to_i64(v), to_i64(total)))
}
