fn bounded_queue(capacity: nat, ops: seq<int>) -> seq<int>
  requires capacity >= 1
  requires forall i in 0..len(ops): ops[i] >= 0
{
  let mut queue: seq<int> = [];
  let mut res: seq<int> = [];
  let mut i: nat = 0;
  
  while i < len(ops)
    invariant 0 <= i && i <= len(ops)
    invariant len(queue) <= capacity
    decreases len(ops) - i
  {
    let op = ops[i];
    if op > 0 {
      // Push operation
      if len(queue) < capacity {
        // Queue is not full, just append
        queue = queue + [op];
      } else {
        // Queue is full, drop oldest and append new
        queue = queue[1..] + [op];
      }
    } else {
      // Pop operation (op == 0)
      if len(queue) > 0 {
        // Queue not empty, pop oldest element
        let popped = queue[0];
        res = res + [popped];
        queue = queue[1..];
      } else {
        // Queue empty, append -1
        res = res + [-1];
      }
    }
    i = i + 1;
  }
  
  return res;
}