fn rle_encode(xs: seq<int>) -> seq<(int, int)>
  requires true
  ensures len(result) <= len(xs)
  ensures forall i in 0..len(result): result[i].1 >= 1
  ensures forall i in 0..len(result) - 1: result[i].0 != result[i + 1].0
{
  if len(xs) == 0 { return []; }
  
  let mut i = 0;
  let mut encoded: seq<(int, int)> = [];
  
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    decreases len(xs) - i
  {
    let value = xs[i];
    let mut count = 1;
    
    // Count consecutive occurrences of value
    while i + count < len(xs) && xs[i + count] == value
      invariant i <= i + count && i + count <= len(xs)
      decreases len(xs) - (i + count)
    {
      count = count + 1;
    }
    
    encoded = encoded + [(value, count)];
    i = i + count;
  }
  
  return encoded;
}