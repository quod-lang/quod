fn binary_search(xs: seq<int>, target: int) -> int
  requires len(xs) == 0 || (forall i in 0..len(xs)-1: xs[i] <= xs[i+1])
  ensures result >= -1 && result < len(xs)
  ensures (result >= 0 ==> xs[result] == target)
{
  if len(xs) == 0 {
    return -1;
  }
  
  let mut left: int = 0;
  let mut right: int = len(xs) - 1;
  
  while left <= right
    decreases right - left
  {
    let mid: int = left + (right - left) / 2;
    
    if xs[mid] == target {
      return mid;
    }
    else if xs[mid] < target {
      left = mid + 1;
    }
    else {
      right = mid - 1;
    }
  }
  
  return -1;
}