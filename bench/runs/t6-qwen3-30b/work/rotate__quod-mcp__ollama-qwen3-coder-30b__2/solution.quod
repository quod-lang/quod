fn rotate(xs: seq<int>, k: int) -> seq<int>
  requires true
  ensures len(result) == len(xs)
  ensures forall i in 0..len(xs): 
    result[(i + k) % len(xs)] == xs[i]
{
  if len(xs) == 0 { return []; }
  
  // Direct implementation using sequence slicing
  let k_mod = k % len(xs);
  return xs[len(xs) - k_mod..] + xs[..len(xs) - k_mod];
}