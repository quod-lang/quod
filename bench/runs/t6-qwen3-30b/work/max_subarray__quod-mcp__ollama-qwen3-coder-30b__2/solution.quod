fn max_subarray(xs: seq<int>) -> int
  requires len(xs) > 0  // input is non-empty
{
  let mut max_ending_here = xs[0];
  let mut max_so_far = xs[0];
  
  let mut i = 1;
  while i < len(xs) 
    invariant 1 <= i && i <= len(xs)
    decreases len(xs) - i
  {
    // Kadane's algorithm step
    if xs[i] > max_ending_here + xs[i] {
      max_ending_here = xs[i];
    } else {
      max_ending_here = max_ending_here + xs[i];
    }
    
    if max_so_far < max_ending_here {
      max_so_far = max_ending_here;
    }
    i = i + 1;
  }
  
  max_so_far
}