// The customer and the coupon, and the discounts they give on an amount.

enum Customer { Guest, Member(int), Business(string) }

enum Coupon { NoCoupon, Percent(int), Fixed(int), FreeShipping }

// A customer is well formed: a member has a nonnegative number of years.
fn customer_ok(c: Customer) -> bool {
  match c {
    Member(years) => years >= 0,
    _ => true,
  }
}

// A coupon is well formed: a percentage in 0..50, and a fixed amount not negative.
fn coupon_ok(k: Coupon) -> bool {
  match k {
    Percent(p) => 0 <= p && p <= 50,
    Fixed(v) => v >= 0,
    _ => true,
  }
}

// The percentage a customer gets on the subtotal `sub`: 5 or 2 for a member,
// 3 for a business from 100000 cents, nothing otherwise.
fn customer_percent(c: Customer, sub: int) -> int {
  match c {
    Guest => 0,
    Member(years) => if years >= 5 { 5 } else { 2 },
    Business(_) => if sub >= 100000 { 3 } else { 0 },
  }
}

// The customer discount on the subtotal `sub`, in cents.
fn customer_discount(c: Customer, sub: int) -> int {
  sub * customer_percent(c, sub) / 100
}

// The coupon discount on `base`, the amount left after the customer discount.
fn coupon_discount(k: Coupon, base: int) -> int {
  match k {
    Percent(p) => base * p / 100,
    Fixed(v) => if v < base { v } else { base },
    _ => 0,
  }
}
