enum Category { Standard, Food, Book, Medicine }
struct Line { sku: string, category: Category, qty: i32, unit_cents: i32, grams: i32 }

fn mul(a: int, b: int) -> int { a * b }

lemma mul_bound(a: int, b: int, ma: int, mb: int)
  requires 0 <= a && a <= ma && 0 <= b && b <= mb
  ensures 0 <= a * b && a * b <= ma * mb
{
  assert (ma - a) * b >= 0;
  assert ma * (mb - b) >= 0;
}

fn valid_line(l: Line) -> bool {
  1 <= l.qty && l.qty <= 10000 && 0 <= l.unit_cents && l.unit_cents <= 100000000 && 0 <= l.grams && l.grams <= 1000000
}

fn vol_pct(l: Line) -> int {
  if l.category == Book { 0 } else { if l.qty >= 100 { 10 } else { if l.qty >= 10 { 5 } else { 0 } } }
}

fn gross(l: Line) -> int { mul(l.qty, l.unit_cents) }

fn line_net(l: Line) -> int { gross(l) - gross(l) * vol_pct(l) / 100 }

fn weight(l: Line) -> int { mul(l.qty, l.grams) }

fn rate(c: Category) -> int
  ensures (c == Standard ==> result == 200) && (c == Food ==> result == 55) && (c == Book ==> result == 55) && (c == Medicine ==> result == 21)
{
  match c { Standard => 200, Food => 55, Book => 55, Medicine => 21 }
}

lemma line_bounds(l: Line)
  requires valid_line(l)
  ensures 0 <= line_net(l) && line_net(l) <= 1000000000000 && 0 <= weight(l) && weight(l) <= 10000000000
{
  mul_bound(l.qty, l.unit_cents, 10000, 100000000);
  mul_bound(l.qty, l.grams, 10000, 1000000);
}

fn all_valid(ls: seq<Line>, i: nat) -> bool
  requires i <= len(ls)
  decreases len(ls) - i
{
  if i == len(ls) { true } else { valid_line(ls[i]) && all_valid(ls, i + 1) }
}

fn sum_net_acc(ls: seq<Line>, i: nat, acc: int) -> int
  requires i <= len(ls)
  decreases len(ls) - i
{
  if i == len(ls) { acc } else { sum_net_acc(ls, i + 1, acc + line_net(ls[i])) }
}

fn cat_net_acc(ls: seq<Line>, i: nat, c: Category, acc: int) -> int
  requires i <= len(ls)
  decreases len(ls) - i
{
  if i == len(ls) { acc } else {
    cat_net_acc(ls, i + 1, c, if ls[i].category == c { acc + line_net(ls[i]) } else { acc })
  }
}

fn weight_acc(ls: seq<Line>, i: nat, acc: int) -> int
  requires i <= len(ls)
  decreases len(ls) - i
{
  if i == len(ls) { acc } else { weight_acc(ls, i + 1, acc + weight(ls[i])) }
}

fn sum_net(ls: seq<Line>) -> int
  ensures result == sum_net_acc(ls, 0, 0)
{ sum_net_acc(ls, 0, 0) }
fn cat_net(ls: seq<Line>, c: Category) -> int
  ensures result == cat_net_acc(ls, 0, c, 0)
{ cat_net_acc(ls, 0, c, 0) }
fn total_weight(ls: seq<Line>) -> int
  ensures result == weight_acc(ls, 0, 0)
{ weight_acc(ls, 0, 0) }

lemma sum_bound(ls: seq<Line>, i: nat, acc: int)
  requires i <= len(ls) && all_valid(ls, i) && 0 <= acc
  ensures acc <= sum_net_acc(ls, i, acc) && sum_net_acc(ls, i, acc) <= acc + (len(ls) - i) * 1000000000000
  decreases len(ls) - i
{
  if i < len(ls) {
    line_bounds(ls[i]);
    sum_bound(ls, i + 1, acc + line_net(ls[i]));
  }
}

lemma cat_bound(ls: seq<Line>, i: nat, c: Category, acc: int)
  requires i <= len(ls) && all_valid(ls, i) && 0 <= acc
  ensures acc <= cat_net_acc(ls, i, c, acc) && cat_net_acc(ls, i, c, acc) <= acc + (len(ls) - i) * 1000000000000
  decreases len(ls) - i
{
  if i < len(ls) {
    line_bounds(ls[i]);
    cat_bound(ls, i + 1, c, if ls[i].category == c { acc + line_net(ls[i]) } else { acc });
  }
}

lemma weight_bound(ls: seq<Line>, i: nat, acc: int)
  requires i <= len(ls) && all_valid(ls, i) && 0 <= acc
  ensures acc <= weight_acc(ls, i, acc) && weight_acc(ls, i, acc) <= acc + (len(ls) - i) * 10000000000
  decreases len(ls) - i
{
  if i < len(ls) {
    line_bounds(ls[i]);
    weight_bound(ls, i + 1, acc + weight(ls[i]));
  }
}
