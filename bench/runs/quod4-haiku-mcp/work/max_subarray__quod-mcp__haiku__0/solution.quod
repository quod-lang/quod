// Sum of xs[i..j) (i included, j excluded).
fn range_sum(xs: seq<int>, i: int, j: int) -> int
  requires 0 <= i && i <= j && j <= len(xs)
  decreases j - i
{
  if i == j { 0 } else { range_sum(xs, i, j - 1) + xs[j - 1] }
}

// Maximum sum over all non-empty contiguous sublists (Kadane's algorithm, O(n)).
//   best : best sum found so far, achieved by xs[bi..bj)
//   cur  : best sum of a sublist ending just before k, which starts at ci
fn max_subarray(xs: seq<int>) -> int
  requires len(xs) > 0
  ensures forall i in 0..len(xs): forall j in i + 1..len(xs) + 1: result >= range_sum(xs, i, j)
  ensures exists i in 0..len(xs): exists j in i + 1..len(xs) + 1: result == range_sum(xs, i, j)
{
  let n = len(xs);
  let mut best = xs[0];
  let mut bi = 0;
  let mut bj = 1;
  let mut cur = xs[0];
  let mut ci = 0;
  let mut k = 1;
  while k < n
    invariant 1 <= k && k <= n
    invariant 0 <= ci && ci < k
    invariant cur == range_sum(xs, ci, k)
    invariant forall i in 0..k: range_sum(xs, i, k) <= cur
    invariant forall i in 0..k: forall j in i + 1..k + 1: best >= range_sum(xs, i, j)
    invariant 0 <= bi && bi < bj && bj <= k
    invariant best == range_sum(xs, bi, bj)
    decreases n - k
  {
    if cur < 0 {
      cur = xs[k];
      ci = k;
    } else {
      cur = cur + xs[k];
    }
    k = k + 1;
    if cur > best {
      best = cur;
      bi = ci;
      bj = k;
    }
  }
  return best;
}
