// Specification helpers. The queue and the output are described step by step,
// one operation at a time, so that the loop can be checked against them.

// Queue after one operation x applied to queue q.
// x > 0: push x, dropping the oldest element first if the queue is full.
// x == 0: pop the oldest element (if any).
fn q_step(capacity: int, q: seq<int>, x: int) -> seq<int>
  requires capacity >= 1
{
  if x > 0 {
    if len(q) >= capacity { q[1..] + [x] } else { q + [x] }
  } else {
    if len(q) == 0 { q } else { q[1..] }
  }
}

// Output after one operation x, given the queue q just before it.
fn o_step(q: seq<int>, out: seq<int>, x: int) -> seq<int>
{
  if x > 0 {
    out
  } else {
    if len(q) == 0 { out + [-1] } else { out + [q[0]] }
  }
}

// Queue after the first n operations.
fn q_after(capacity: int, ops: seq<int>, n: int) -> seq<int>
  requires capacity >= 1
  requires 0 <= n && n <= len(ops)
  decreases n
{
  if n == 0 { [] } else { q_step(capacity, q_after(capacity, ops, n - 1), ops[n - 1]) }
}

// Output after the first n operations.
fn o_after(capacity: int, ops: seq<int>, n: int) -> seq<int>
  requires capacity >= 1
  requires 0 <= n && n <= len(ops)
  decreases n
{
  if n == 0 { [] } else { o_step(q_after(capacity, ops, n - 1), o_after(capacity, ops, n - 1), ops[n - 1]) }
}

fn bounded_queue(capacity: int, ops: seq<int>) -> seq<int>
  requires capacity >= 1
  requires forall k in 0..len(ops): ops[k] >= 0
  ensures result == o_after(capacity, ops, len(ops))
{
  let mut q: seq<int> = [];
  let mut out: seq<int> = [];
  let mut i: int = 0;
  while i < len(ops)
    invariant 0 <= i && i <= len(ops)
    invariant q == q_after(capacity, ops, i)
    invariant out == o_after(capacity, ops, i)
    decreases len(ops) - i
  {
    let x = ops[i];
    out = o_step(q, out, x);
    q = q_step(capacity, q, x);
    i = i + 1;
  }
  return out;
}
