// Rotate xs to the right by k positions (k may be any integer).
// Result[i] is xs[(i - k) mod n], with Euclidean mod, so negative k rotates left
// and k larger than n wraps around.
fn rotate(xs: seq<int>, k: int) -> seq<int>
  ensures len(result) == len(xs)
  ensures len(xs) > 0 ==> forall i in 0..len(xs): result[i] == xs[(i - k) % len(xs)]
{
  let n = len(xs);
  if n == 0 {
    return [];
  }
  let mut out: seq<int> = [];
  let mut i = 0;
  while i < n
    invariant 0 <= i && i <= n
    invariant len(out) == i
    invariant forall j in 0..i: out[j] == xs[(j - k) % n]
    decreases n - i
  {
    out = out + [xs[(i - k) % n]];
    i = i + 1;
  }
  return out;
}
