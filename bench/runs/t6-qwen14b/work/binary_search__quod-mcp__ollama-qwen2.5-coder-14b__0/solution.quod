fn binary_search(xs: seq<int>, target: int) -> int
  requires sorted(xs)
  ensures xs[return] == target or return == -1
  decreases len(xs)
{
  let mut lo = 0;
  let mut hi = len(xs);
  while lo < hi
    invariant lo <= hi
    invariant xs[..lo] < target
    invariant xs[hi..] > target
    decreases hi - lo
  {
    let mid = lo + (hi - lo) / 2;
    if xs[mid] < target { lo = mid + 1; }
    else if xs[mid] > target { hi = mid; }
    else { return mid; }
  }
  return -1;
}