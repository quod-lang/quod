fn rle_encode(xs: seq<int>) -> seq<(int, int)>
{
  if len(xs) == 0 { return []; }
  let mut result = [];
  let mut i = 0;
  while i < len(xs) {
    let mut count = 1;
    while i + count < len(xs) && xs[i] == xs[i + count] {
      count = count + 1;
    }
    result = result + [(xs[i], count)];
    i = i + count;
  }
  return result;
}