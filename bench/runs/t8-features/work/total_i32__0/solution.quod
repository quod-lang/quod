// Sum of the elements of xs, 0 when xs is empty.
// The input guarantees len(xs) <= 1000000, so the sum fits in i64.

// Mathematical sum of the first n elements of xs.
fn sum_upto(xs: seq<i32>, n: nat) -> int
  requires n <= len(xs)
  decreases n
{
  if n == 0 { 0 } else { sum_upto(xs, n - 1) + xs[n - 1] }
}

fn total(xs: seq<i32>) -> i64
  requires len(xs) <= 1000000
  ensures result == sum_upto(xs, len(xs))
{
  let mut acc: i64 = 0;
  let mut i: nat = 0;
  while i < len(xs)
    invariant 0 <= i && i <= len(xs)
    invariant acc == sum_upto(xs, i)
    invariant -2147483648 * i <= acc && acc <= 2147483647 * i
    decreases len(xs) - i
  {
    acc = acc + xs[i];
    i = i + 1;
  }
  acc
}
