enum Customer {
  Regular,
  Member(nat),
  Staff,
}

fn percent(c: Customer) -> int
  ensures match c {
    Regular => result == 0,
    Member(years) => (years >= 5 ==> result == 10) && (years < 5 ==> result == 5),
    Staff => result == 30,
  }
{
  match c {
    Regular => 0,
    Member(years) => if years >= 5 { 10 } else { 5 },
    Staff => 30,
  }
}

fn discounted(amount: int, c: Customer) -> int
  requires 0 <= amount && amount <= 10000000
  ensures 0 <= result && result <= amount
  ensures 100 * (amount - result) <= amount * percent(c)
  ensures amount * percent(c) < 100 * (amount - result) + 100
{
  amount - amount * percent(c) / 100
}
