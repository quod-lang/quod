import option
import strings

// Index of the first '=' in s at or after position i, or -1 if there is none.
fn find_eq_from(s: string, i: int) -> int
  requires 0 <= i && i <= len(s)
  ensures -1 <= result && result < len(s)
  ensures result >= 0 ==> i <= result && s[result] == '=' && (forall j in i..result: s[j] != '=')
  ensures result < 0 ==> (forall j in i..len(s): s[j] != '=')
  decreases len(s) - i
{
  if i == len(s) {
    -1
  } else {
    if s[i] == '=' { i } else { find_eq_from(s, i + 1) }
  }
}

fn parse_kv(s: string) -> option.Option<(string, string)>
  ensures match result {
    Some(p) => find_eq_from(s, 0) >= 0 && p.0 == strings.trim(s[..find_eq_from(s, 0)]) && p.1 == strings.trim(s[find_eq_from(s, 0) + 1..]) && p.0 != "",
    None => find_eq_from(s, 0) < 0 || strings.trim(s[..find_eq_from(s, 0)]) == "",
  }
{
  let i: int = find_eq_from(s, 0);
  if i < 0 {
    return option.None;
  }
  let key: string = strings.trim(s[..i]);
  if len(key) == 0 {
    return option.None;
  }
  option.Some((key, strings.trim(s[i + 1..])))
}
