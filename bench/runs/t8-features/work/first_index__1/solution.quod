import option

fn first_index(xs: seq<i32>, x: i32) -> option.Option<nat>
  ensures match result {
    Some(i) => i < len(xs) && xs[i] == x && forall j in 0..i: xs[j] != x,
    None => forall j in 0..len(xs): xs[j] != x,
  }
{
  let mut i: nat = 0;
  let mut found: bool = false;
  let mut at: nat = 0;
  while i < len(xs) && !found
    invariant 0 <= i && i <= len(xs)
    invariant found ==> (at < i && xs[at] == x && forall j in 0..at: xs[j] != x)
    invariant !found ==> forall j in 0..i: xs[j] != x
    decreases len(xs) - i
  {
    if xs[i] == x {
      found = true;
      at = i;
    }
    i = i + 1;
  }
  if found {
    option.Some(at)
  } else {
    option.None
  }
}
