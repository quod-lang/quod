fn rle_encode(xs: seq<int>) -> seq<(int, int)>
  requires len(xs) >= 0
  ensures len(result) >= 0
  ensures forall i in 0..len(result) { result[i].1 >= 1 }
  ensures forall i in 0..len(result) { forall j in 0..result[i].1 { xs[i + j] == result[i].0 } }
  ensures forall i in 0..len(result) { i == 0 || result[i].0 != result[i - 1].0 }
  ensures forall i in 0..len(result) { i == len(result) - 1 || result[i].0 != result[i + 1].0 }
{
  if len(xs) == 0 { return []; }
  let mut res: seq<(int, int)> = [];
  let mut i = 0;
  while i < len(xs) decreases len(xs) - i {
    let mut count = 1;
    while i + count < len(xs) && xs[i] == xs[i + count] decreases len(xs) - i - count {
      count = count + 1;
    }
    res = res + [(xs[i], count)];
    i = i + count;
  }
  return res;
}