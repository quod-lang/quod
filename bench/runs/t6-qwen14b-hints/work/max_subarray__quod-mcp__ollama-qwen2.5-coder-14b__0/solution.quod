fn max_subarray(xs: seq<int>) -> int
requires len(xs) > 0
ensures result >= 0
ensures result == max(sum(sublist) for sublist in sublists(xs))
where sublists(xs) == [xs[i:j] for i in range(len(xs)) for j in range(i+1, len(xs)+1)]
{
  let mut max_sum = xs[0]
  let mut current_sum = xs[0]
  let mut i = 1
  while i < len(xs)
  {
    current_sum = max(xs[i], current_sum + xs[i])
    max_sum = max(max_sum, current_sum)
    i = i + 1
  }
  return max_sum
}
