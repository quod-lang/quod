fn arbitrate_field(candidates: seq<(int, int, int)>, rank: seq<int>, threshold: int) -> int
  requires 0 <= threshold <= 100
  requires forall i in 0..len(candidates): 0 <= candidates[i].0 < len(rank)
  requires forall i in 0..len(candidates): 0 <= candidates[i].1 <= 100
  ensures result == -1 ==> forall i in 0..len(candidates): candidates[i].1 < threshold
  ensures result != -1 ==> 0 <= result < len(candidates)
  ensures result != -1 ==> candidates[result].1 >= threshold
  ensures result != -1 ==> forall i in 0..len(candidates):
    candidates[i].1 >= threshold ==>
      (candidates[result].1 > candidates[i].1
       || (candidates[result].1 == candidates[i].1 && rank[candidates[result].0] < rank[candidates[i].0])
       || (candidates[result].1 == candidates[i].1 && rank[candidates[result].0] == rank[candidates[i].0] && result <= i))
{
  let mut best: int = -1;
  let mut i: int = 0;
  while i < len(candidates)
    invariant 0 <= i <= len(candidates)
    invariant best == -1 ==> forall j in 0..i: candidates[j].1 < threshold
    invariant best != -1 ==> 0 <= best < i
    invariant best != -1 ==> candidates[best].1 >= threshold
    invariant best != -1 ==> forall j in 0..i:
      candidates[j].1 >= threshold ==>
        (candidates[best].1 > candidates[j].1
         || (candidates[best].1 == candidates[j].1 && rank[candidates[best].0] < rank[candidates[j].0])
         || (candidates[best].1 == candidates[j].1 && rank[candidates[best].0] == rank[candidates[j].0] && best <= j))
    decreases len(candidates) - i
  {
    if candidates[i].1 >= threshold {
      if best == -1 {
        best = i;
      } else if candidates[i].1 > candidates[best].1
          || (candidates[i].1 == candidates[best].1 && rank[candidates[i].0] < rank[candidates[best].0]) {
        best = i;
      }
    }
    i = i + 1;
  }
  return best;
}
