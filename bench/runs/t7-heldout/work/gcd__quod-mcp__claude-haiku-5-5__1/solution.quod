// Absolute value.
fn abs_int(x: int) -> int {
  if x < 0 { -x } else { x }
}

// Reference model: Euclid's algorithm on the integers. gcd(a, b) = gcd(b, a mod b),
// with the Euclidean remainder (always >= 0), and gcd(a, 0) = |a|.
fn gcd_model(a: int, b: int) -> int
  decreases abs_int(b)
{
  if b == 0 { abs_int(a) } else { gcd_model(b, a % b) }
}

fn gcd(a: int, b: int) -> int
  ensures result >= 0
  ensures result == gcd_model(a, b)
{
  let mut x: int = a;
  let mut y: int = b;
  while y != 0
    invariant gcd_model(x, y) == gcd_model(a, b)
    decreases abs_int(y)
  {
    let t: int = x % y;
    x = y;
    y = t;
  }
  abs_int(x)
}
