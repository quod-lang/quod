// Number of occurrences of v in s.
fn count(s: seq<int>, v: int) -> int
  decreases len(s)
{
  if len(s) == 0 { 0 } else { (if s[0] == v { 1 } else { 0 }) + count(s[1..], v) }
}

// Reversal of s.
fn rev(s: seq<int>) -> seq<int>
  decreases len(s)
{
  if len(s) <= 1 { s } else { [s[len(s) - 1]] + rev(s[..len(s) - 1]) }
}

lemma count_append(a: seq<int>, b: seq<int>, v: int)
  ensures count(a + b, v) == count(a, v) + count(b, v)
  decreases len(a)
{
  if len(a) > 0 {
    count_append(a[1..], b, v);
    assert (a + b)[1..] == a[1..] + b;
  }
}

// Splitting a sequence around one position.
lemma split_at(s: seq<int>, k: int)
  requires 0 <= k && k < len(s)
  ensures s[..k] + [s[k]] + s[k + 1..] == s
{
  assert s[..k] + s[k..] == s;
  assert s[k..] == [s[k]] + s[k + 1..];
}

lemma split_last(s: seq<int>)
  requires len(s) >= 1
  ensures s[..len(s) - 1] + [s[len(s) - 1]] == s
{
  split_at(s, len(s) - 1);
  assert s[len(s)..] == [];
}

// Splitting a suffix around one position inside it.
lemma split_inner(s: seq<int>, a: int, b: int)
  requires 0 <= a && a <= b && b < len(s)
  ensures s[a..] == s[a..b] + [s[b]] + s[b + 1..]
{
  assert s[a..] == s[a..b] + s[b..];
  assert s[b..] == [s[b]] + s[b + 1..];
}

lemma rev_all(s: seq<int>)
  ensures len(rev(s)) == len(s)
  ensures forall t in 0..len(s): rev(s)[t] == s[len(s) - 1 - t]
  decreases len(s)
{
  if len(s) > 1 {
    rev_all(s[..len(s) - 1]);
  }
}

lemma rev_count(s: seq<int>, v: int)
  ensures count(rev(s), v) == count(s, v)
  decreases len(s)
{
  if len(s) > 1 {
    rev_count(s[..len(s) - 1], v);
    count_append([s[len(s) - 1]], rev(s[..len(s) - 1]), v);
    count_append(s[..len(s) - 1], [s[len(s) - 1]], v);
    split_last(s);
  }
}

// Reversing a non-increasing sequence gives a non-decreasing one.
lemma rev_sorted(s: seq<int>)
  requires forall j in 0..len(s) - 1: s[j] >= s[j + 1]
  ensures forall j in 0..len(rev(s)) - 1: rev(s)[j] <= rev(s)[j + 1]
{
  rev_all(s);
}

// Same multiset, element by element, for a reversal.
lemma rev_elem(s: seq<int>, k0: int)
  requires 0 <= k0 && k0 <= len(s)
  ensures forall k in k0..len(s): count(rev(s), rev(s)[k]) == count(s, rev(s)[k])
  decreases len(s) - k0
{
  rev_all(s);
  if k0 < len(s) {
    rev_count(s, rev(s)[k0]);
    rev_elem(s, k0 + 1);
  }
}

// In a non-increasing run, every element from c up to hi is at least xs[hi].
lemma nonincr_chain(xs: seq<int>, lo: int, hi: int)
  requires 0 <= lo && lo <= hi && hi < len(xs)
  requires forall j in lo..hi: xs[j] >= xs[j + 1]
  ensures forall c in lo..hi + 1: xs[c] >= xs[hi]
  decreases hi - lo
{
  if lo < hi {
    nonincr_chain(xs, lo + 1, hi);
  }
}

// The multiset of the pivot construction is that of xs.
lemma piv_len(xs: seq<int>, i: int, jj: int)
  requires 0 <= i && i < jj && jj < len(xs)
  ensures len(xs[..i] + [xs[jj]] + rev(xs[i + 1..jj] + [xs[i]] + xs[jj + 1..])) == len(xs)
{
  rev_all(xs[i + 1..jj] + [xs[i]] + xs[jj + 1..]);
}

lemma piv_count(xs: seq<int>, i: int, jj: int, v: int)
  requires 0 <= i && i < jj && jj < len(xs)
  ensures count(xs[..i] + [xs[jj]] + rev(xs[i + 1..jj] + [xs[i]] + xs[jj + 1..]), v) == count(xs, v)
{
  rev_count(xs[i + 1..jj] + [xs[i]] + xs[jj + 1..], v);
  count_append(xs[..i] + [xs[jj]], rev(xs[i + 1..jj] + [xs[i]] + xs[jj + 1..]), v);
  count_append(xs[..i], [xs[jj]], v);
  count_append(xs[i + 1..jj] + [xs[i]], xs[jj + 1..], v);
  count_append(xs[i + 1..jj], [xs[i]], v);
  count_append(xs[..i], [xs[i]], v);
  count_append(xs[..i] + [xs[i]], xs[i + 1..], v);
  count_append(xs[i + 1..jj] + [xs[jj]], xs[jj + 1..], v);
  count_append(xs[i + 1..jj], [xs[jj]], v);
  split_at(xs, i);
  split_inner(xs, i + 1, jj);
  count_append(xs[..i] + [xs[i]], xs[i + 1..], v);
}

lemma piv_elem(xs: seq<int>, i: int, jj: int, k0: int)
  requires 0 <= i && i < jj && jj < len(xs)
  requires 0 <= k0 && k0 <= len(xs)
  ensures forall k in k0..len(xs): count(xs[..i] + [xs[jj]] + rev(xs[i + 1..jj] + [xs[i]] + xs[jj + 1..]), (xs[..i] + [xs[jj]] + rev(xs[i + 1..jj] + [xs[i]] + xs[jj + 1..]))[k]) == count(xs, (xs[..i] + [xs[jj]] + rev(xs[i + 1..jj] + [xs[i]] + xs[jj + 1..]))[k])
  decreases len(xs) - k0
{
  piv_len(xs, i, jj);
  if k0 < len(xs) {
    piv_count(xs, i, jj, (xs[..i] + [xs[jj]] + rev(xs[i + 1..jj] + [xs[i]] + xs[jj + 1..]))[k0]);
    piv_elem(xs, i, jj, k0 + 1);
  }
}

fn next_permutation(xs: seq<int>) -> seq<int>
  ensures len(result) == len(xs)
  ensures forall k in 0..len(result): count(result, result[k]) == count(xs, result[k])
  ensures forall k in 0..len(xs) - 1: (xs[k] < xs[k + 1] && (forall j in k + 1..len(xs) - 1: xs[j] >= xs[j + 1])) ==> (result[..k] == xs[..k] && xs[k] < result[k] && (forall j in k + 1..len(xs): xs[j] > xs[k] ==> result[k] <= xs[j]) && (forall j in k + 1..len(xs) - 1: result[j] <= result[j + 1]))
  ensures (forall k in 0..len(xs) - 1: xs[k] >= xs[k + 1]) ==> (forall j in 0..len(result) - 1: result[j] <= result[j + 1])
{
  let n = len(xs);
  if n < 2 {
    return xs;
  }
  let mut i: int = n - 2;
  while i >= 0 && xs[i] >= xs[i + 1]
    invariant -1 <= i && i <= n - 2
    invariant forall j in i + 1..n - 1: xs[j] >= xs[j + 1]
    decreases i + 1
  {
    i = i - 1;
  }
  if i < 0 {
    rev_sorted(xs);
    rev_all(xs);
    rev_elem(xs, 0);
    return rev(xs);
  }
  let mut jj: int = n - 1;
  while xs[jj] <= xs[i]
    invariant i + 1 <= jj && jj <= n - 1
    invariant forall t in jj + 1..n: xs[t] <= xs[i]
    decreases jj
  {
    jj = jj - 1;
  }
  nonincr_chain(xs, i + 1, jj);
  let sp = xs[i + 1..jj] + [xs[i]] + xs[jj + 1..];
  rev_sorted(sp);
  rev_all(sp);
  piv_elem(xs, i, jj, 0);
  let res = xs[..i] + [xs[jj]] + rev(sp);
  return res;
}
