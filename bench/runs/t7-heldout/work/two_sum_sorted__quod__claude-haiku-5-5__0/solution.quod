// Two-sum on a sorted sequence, by two pointers moving inward.

// Sortedness gives: every element at index <= j is at most xs[j].
lemma sorted_le_upto(xs: seq<int>, j: int)
  requires forall k in 0..len(xs) - 1: xs[k] <= xs[k + 1]
  requires 0 <= j < len(xs)
  ensures forall b in 0..j + 1: xs[b] <= xs[j]
  decreases j
{
  if j > 0 {
    sorted_le_upto(xs, j - 1);
    assert xs[j - 1] <= xs[j];
  }
}

// Sortedness gives: every element at index >= i is at least xs[i].
lemma sorted_ge_from(xs: seq<int>, i: int)
  requires forall k in 0..len(xs) - 1: xs[k] <= xs[k + 1]
  requires 0 <= i < len(xs)
  ensures forall a in i..len(xs): xs[i] <= xs[a]
  decreases len(xs) - i
{
  if i + 1 < len(xs) {
    sorted_ge_from(xs, i + 1);
    assert xs[i] <= xs[i + 1];
  }
}

fn two_sum_sorted(xs: seq<int>, target: int) -> (int, int)
  requires forall k in 0..len(xs) - 1: xs[k] <= xs[k + 1]
  ensures (result.0 == -1 && result.1 == -1)
    || (0 <= result.0 && result.0 < result.1 && result.1 < len(xs)
        && xs[result.0] + xs[result.1] == target)
  ensures result.0 == -1 ==> forall i in 0..len(xs): forall j in i + 1..len(xs): xs[i] + xs[j] != target
  loose (a, b) => (a.0 == -1) == (b.0 == -1)
{
  let mut i: int = 0;
  let mut j: int = len(xs) - 1;
  while i < j
    invariant 0 <= i
    invariant j < len(xs)
    invariant forall a in 0..len(xs): forall b in a + 1..len(xs): (a < i || b > j) ==> xs[a] + xs[b] != target
    decreases j - i
  {
    let s: int = xs[i] + xs[j];
    if s == target {
      return (i, j);
    }
    if s < target {
      sorted_le_upto(xs, j);
      i = i + 1;
    } else {
      sorted_ge_from(xs, i);
      j = j - 1;
    }
  }
  return (-1, -1);
}
