fn transpose(m: seq<seq<int>>) -> seq<seq<int>>
  requires len(m) >= 1
  requires len(m[0]) >= 1
  requires forall r in 0..len(m): len(m[r]) == len(m[0])
  ensures len(result) == len(m[0])
  ensures forall i in 0..len(result): len(result[i]) == len(m) && forall j in 0..len(m): result[i][j] == m[j][i]
{
  let w: int = len(m[0]);
  let h: int = len(m);
  let mut res: seq<seq<int>> = [];
  let mut i: int = 0;
  while i < w
    invariant 0 <= i <= w
    invariant len(res) == i
    invariant forall k in 0..i: len(res[k]) == h
    invariant forall k in 0..i: forall j in 0..h: res[k][j] == m[j][k]
    decreases w - i
  {
    let mut row: seq<int> = [];
    let mut j: int = 0;
    while j < h
      invariant 0 <= j <= h
      invariant len(row) == j
      invariant forall t in 0..j: row[t] == m[t][i]
      decreases h - j
    {
      row = row + [m[j][i]];
      j = j + 1;
    }
    res = res + [row];
    i = i + 1;
  }
  res
}
