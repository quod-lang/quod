// Two sum on a sorted sequence, by two pointers.
//
// The result is determined: when a valid pair exists, it is the pair (a, b) where
// a is the smallest first index of any valid pair and b the largest second index
// of any valid pair (such a pair is itself valid). Otherwise it is (-1, -1).

fn two_sum_sorted(xs: seq<int>, target: int) -> (int, int)
  requires forall a in 0..len(xs): forall b in a..len(xs): xs[a] <= xs[b]
  ensures result.0 == -1 ==>
    (result.1 == -1 && forall p in 0..len(xs): forall q in p + 1..len(xs): xs[p] + xs[q] != target)
  ensures result.0 != -1 ==>
    (0 <= result.0 && result.0 < result.1 && result.1 < len(xs)
     && xs[result.0] + xs[result.1] == target
     && (forall p in 0..result.0: forall q in p + 1..len(xs): xs[p] + xs[q] != target)
     && (forall q in result.1 + 1..len(xs): forall p in 0..q: xs[p] + xs[q] != target))
{
  let mut i: int = 0;
  let mut j: int = len(xs) - 1;
  while i < j
    invariant 0 <= i
    invariant j < len(xs)
    invariant forall p in 0..i: forall q in p + 1..len(xs): xs[p] + xs[q] != target
    invariant forall q in j + 1..len(xs): forall p in 0..q: xs[p] + xs[q] != target
    decreases j - i
  {
    let s = xs[i] + xs[j];
    if s == target {
      return (i, j);
    } else if s < target {
      i = i + 1;
    } else {
      j = j - 1;
    }
  }
  return (-1, -1);
}
