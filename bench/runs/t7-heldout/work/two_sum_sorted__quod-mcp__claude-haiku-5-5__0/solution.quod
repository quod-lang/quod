// Two-pointer search on a sorted sequence.
fn two_sum_sorted(xs: seq<int>, target: int) -> (int, int)
  requires forall a in 0..len(xs): forall b in 0..len(xs): a <= b ==> xs[a] <= xs[b]
  ensures (result.0 == -1 && result.1 == -1) ==> forall a in 0..len(xs): forall b in 0..len(xs): !(a < b && xs[a] + xs[b] == target)
  ensures (result.0 != -1 || result.1 != -1) ==> (0 <= result.0 && result.0 < result.1 && result.1 < len(xs) && xs[result.0] + xs[result.1] == target)
  loose (a, b) => (a.0 == -1) == (b.0 == -1)
{
  let mut i: int = 0;
  let mut j: int = len(xs) - 1;
  while i < j
    invariant 0 <= i
    invariant j < len(xs)
    invariant forall a in 0..len(xs): forall b in 0..len(xs): (a < b && xs[a] + xs[b] == target) ==> (i <= a && b <= j)
    decreases j - i
  {
    let s: int = xs[i] + xs[j];
    if s == target {
      return (i, j);
    }
    if s < target {
      i = i + 1;
    } else {
      j = j - 1;
    }
  }
  return (-1, -1);
}
