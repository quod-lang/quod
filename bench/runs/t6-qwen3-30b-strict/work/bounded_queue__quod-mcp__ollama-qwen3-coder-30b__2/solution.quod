fn bounded_queue(capacity: nat, ops: seq<int>) -> seq<int>
  requires capacity >= 1
  ensures len(result) == len(ops)
{
  let mut queue: seq<int> = [];
  let mut res: seq<int> = [];
  let mut i: nat = 0;
  
  while i < len(ops)
    invariant 0 <= i && i <= len(ops)
    decreases len(ops) - i
  {
    let op = ops[i];
    if op > 0 {
      // Push operation
      if len(queue) == capacity {
        // Queue is full, drop the oldest element (at index 0)
        queue = queue[1..];
      }
      // Add new element to the end of queue
      queue = queue + [op];
    } else {
      // Pop operation (op == 0)
      if len(queue) > 0 {
        // Queue not empty, pop the oldest element (at index 0)
        res = res + [queue[0]];
        // Remove the first element
        queue = queue[1..];
      } else {
        // Queue is empty, append -1 to result
        res = res + [-1];
      }
    }
    i = i + 1;
  }
  
  return res;
}