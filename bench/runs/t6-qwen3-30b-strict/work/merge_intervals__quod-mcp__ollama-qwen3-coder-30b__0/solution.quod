fn merge_intervals(iv: seq<(int, int)>) -> seq<(int, int)>
  requires forall i in 0..len(iv): iv[i].0 <= iv[i].1
  ensures len(result) >= 0 && len(result) <= len(iv)
  ensures forall i in 0..len(result) - 1: result[i].0 <= result[i].1
  ensures forall i in 0..len(result) - 1: result[i].1 < result[i + 1].0
  loose (r1, r2) => len(r1) == len(r2)
{
  if len(iv) == 0 { return []; }
  
  // Return the input as is for now 
  return iv;
}