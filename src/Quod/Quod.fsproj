<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>quod</AssemblyName>
    <RootNamespace>Quod</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Native AOT: `quod` is a self-contained native binary, no .NET runtime to install. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- No reflection-based ToString() on records and unions (they use printf %A, which is
         not AOT-safe). The compiler never relies on them. -->
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Syntax.fs" />
    <Compile Include="Diagnostics.fs" />
    <Compile Include="Lexer.fs" />
    <Compile Include="Parser.fs" />
    <Compile Include="Printer.fs" />
    <Compile Include="Typed.fs" />
    <Compile Include="Typecheck.fs" />
    <Compile Include="Eval.fs" />
    <Compile Include="Smt.fs" />
    <Compile Include="Vcgen.fs" />
    <Compile Include="CodegenPython.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
