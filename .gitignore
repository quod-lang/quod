__pycache__/
*.egg-info/
build/
dist/
.venv/

# Dafny build outputs
_build/
*-py/

# dafny-complete temporary files (next to the checked file)
.*.dafny-complete.*

# generated by bench/verifbench/completeness.py and witness.py
bench/completeness/

# early smoke tests, not part of the reported results
bench/runs/smoke*/

# mutated programs written by bench/verifbench/mutants.py (the jsonl and log are kept)
bench/runs/mutants-*/

# unpublished drafts
docs/drafts/

# .NET build outputs
bin/
obj/
proto/z3-aot/out/
artifacts/

# Visual Studio cache
.vs/
*.user
*.suo
TestResults/

# T8: transcripts hold the configuration of the machine that ran them
bench/runs/t8-features/work/*/agent_stdout.jsonl
bench/runs/t8-features/work/*/agent_stderr.txt
bench/runs/t8-features/work/*/.mcp.json
bench/runs/t8-features/work/*/_py/
bench/runs/t8-features.log
bench/runs/t9-billing/work/*/agent_stdout.jsonl
bench/runs/t9-billing/work/*/agent_stderr.txt
bench/runs/t9-billing/work/*/.mcp.json
bench/runs/t9-billing/work/*/_py/
bench/runs/t9-billing.log
bench/runs/t10-proportional/work/*/agent_stdout.jsonl
bench/runs/t10-proportional/work/*/agent_stderr.txt
bench/runs/t10-proportional/work/*/.mcp.json
bench/runs/t10-proportional/work/*/_py/
bench/runs/t10-proportional.log
bench/runs/t11-private/work/*/agent_stdout.jsonl
bench/runs/t11-private/work/*/agent_stderr.txt
bench/runs/t11-private/work/*/.mcp.json
bench/runs/t11-private/work/*/_py/
bench/runs/t11-private.log
